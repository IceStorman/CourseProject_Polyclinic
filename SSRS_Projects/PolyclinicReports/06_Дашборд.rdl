<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df"><df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily><AutoRefresh>0</AutoRefresh><Description>Дашборд (OLAP): KPI з індикаторами стану, датчики, динаміка візитів, тренди відділень (спарклайни), топ-5 хвороб.</Description><DataSources><DataSource Name="PolyclinicDW"><DataSourceReference>PolyclinicDW</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>b44974ed-f465-460a-8bed-c3c22194a513</rd:DataSourceID></DataSource><DataSource Name="PolyclinicOLAP"><DataSourceReference>PolyclinicOLAP</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>47512a98-96fa-4224-96a7-03b7d67c38e2</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="dsYears"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT YearNo, N'[Дата].[Рік].&amp;[' + CAST(YearNo AS nvarchar(4)) + N']' AS YearMdx, N'[Дата].[Календар].[Рік].&amp;[' + CAST(YearNo AS nvarchar(4)) + N']' AS YearCalMdx FROM dim.DimDate WHERE YearNo BETWEEN 2016 AND 2025 ORDER BY YearNo DESC</CommandText></Query><Fields><Field Name="YearNo"><DataField>YearNo</DataField><rd:TypeName>System.Int16</rd:TypeName></Field><Field Name="YearMdx"><DataField>YearMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="YearCalMdx"><DataField>YearCalMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsKpi"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="YearCal"><Value>=Parameters!Year.Value</Value></QueryParameter></QueryParameters><CommandText>
WITH MEMBER [Measures].[EffValue] AS KPIValue(&quot;Ефективність лікування&quot;) MEMBER [Measures].[EffGoal] AS KPIGoal(&quot;Ефективність лікування&quot;) MEMBER [Measures].[EffStatus] AS KPIStatus(&quot;Ефективність лікування&quot;) MEMBER [Measures].[NormValue] AS KPIValue(&quot;Дотримання нормативу лікування&quot;) MEMBER [Measures].[NormGoal] AS KPIGoal(&quot;Дотримання нормативу лікування&quot;) MEMBER [Measures].[NormStatus] AS KPIStatus(&quot;Дотримання нормативу лікування&quot;) MEMBER [Measures].[NoShowValue] AS KPIValue(&quot;Частка неявок&quot;) MEMBER [Measures].[NoShowGoal] AS KPIGoal(&quot;Частка неявок&quot;) MEMBER [Measures].[NoShowStatus] AS KPIStatus(&quot;Частка неявок&quot;) MEMBER [Measures].[GrowthValue] AS KPIValue(&quot;Ріст виручки&quot;) MEMBER [Measures].[GrowthGoal] AS KPIGoal(&quot;Ріст виручки&quot;) MEMBER [Measures].[GrowthStatus] AS KPIStatus(&quot;Ріст виручки&quot;)
SELECT { [Measures].[EffValue], [Measures].[EffGoal], [Measures].[EffStatus], [Measures].[NormValue], [Measures].[NormGoal], [Measures].[NormStatus], [Measures].[NoShowValue], [Measures].[NoShowGoal], [Measures].[NoShowStatus], [Measures].[GrowthValue], [Measures].[GrowthGoal], [Measures].[GrowthStatus],
          [Measures].[Кількість візитів], [Measures].[Виручка], [Measures].[Унікальні пацієнти], [Measures].[Випадки лікування] } ON COLUMNS
FROM [Поліклініка] WHERE ( STRTOMEMBER(@YearCal, CONSTRAINED) )</CommandText></Query><Fields><Field Name="EffValue"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[EffValue]&quot; /&gt;</DataField></Field><Field Name="EffGoal"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[EffGoal]&quot; /&gt;</DataField></Field><Field Name="EffStatus"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[EffStatus]&quot; /&gt;</DataField></Field><Field Name="NormValue"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[NormValue]&quot; /&gt;</DataField></Field><Field Name="NormGoal"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[NormGoal]&quot; /&gt;</DataField></Field><Field Name="NormStatus"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[NormStatus]&quot; /&gt;</DataField></Field><Field Name="NoShowValue"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[NoShowValue]&quot; /&gt;</DataField></Field><Field Name="NoShowGoal"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[NoShowGoal]&quot; /&gt;</DataField></Field><Field Name="NoShowStatus"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[NoShowStatus]&quot; /&gt;</DataField></Field><Field Name="GrowthValue"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[GrowthValue]&quot; /&gt;</DataField></Field><Field Name="GrowthGoal"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[GrowthGoal]&quot; /&gt;</DataField></Field><Field Name="GrowthStatus"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[GrowthStatus]&quot; /&gt;</DataField></Field><Field Name="Visits"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Кількість візитів]&quot; /&gt;</DataField></Field><Field Name="Revenue"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Виручка]&quot; /&gt;</DataField></Field><Field Name="Patients"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Унікальні пацієнти]&quot; /&gt;</DataField></Field><Field Name="Cases"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Випадки лікування]&quot; /&gt;</DataField></Field></Fields></DataSet><DataSet Name="dsMonthly"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="YearCal"><Value>=Parameters!Year.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT NON EMPTY { [Measures].[Кількість візитів], [Measures].[Візити PY] } ON COLUMNS,
NON EMPTY DESCENDANTS(STRTOMEMBER(@YearCal, CONSTRAINED), [Дата].[Календар].[Місяць]) ON ROWS
FROM [Поліклініка]</CommandText></Query><Fields><Field Name="Month"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Дата].[Календар].[Місяць]&quot; /&gt;</DataField></Field><Field Name="Visits"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Кількість візитів]&quot; /&gt;</DataField></Field><Field Name="VisitsPY"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Візити PY]&quot; /&gt;</DataField></Field></Fields></DataSet><DataSet Name="dsDepartments"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="YearCal"><Value>=Parameters!Year.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT NON EMPTY { [Measures].[Кількість візитів], [Measures].[Виручка], [Measures].[Виручка PY] } ON COLUMNS,
NON EMPTY ( [Лікар].[Відділення].[Відділення].ALLMEMBERS * DESCENDANTS(STRTOMEMBER(@YearCal, CONSTRAINED), [Дата].[Календар].[Місяць]) ) ON ROWS
FROM [Поліклініка]</CommandText></Query><Fields><Field Name="Department"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Лікар].[Відділення].[Відділення]&quot; /&gt;</DataField></Field><Field Name="Month"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Дата].[Календар].[Місяць]&quot; /&gt;</DataField></Field><Field Name="Visits"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Кількість візитів]&quot; /&gt;</DataField></Field><Field Name="Revenue"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Виручка]&quot; /&gt;</DataField></Field><Field Name="RevenuePY"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Виручка PY]&quot; /&gt;</DataField></Field></Fields></DataSet><DataSet Name="dsTopDiseases"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="YearCal"><Value>=Parameters!Year.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT { [Measures].[Випадки лікування], [Measures].[Ефективність лікування] } ON COLUMNS,
TOPCOUNT([Хвороба].[Хвороба].[Хвороба].MEMBERS, 5, [Measures].[Випадки лікування]) ON ROWS
FROM [Поліклініка] WHERE ( STRTOMEMBER(@YearCal, CONSTRAINED) )</CommandText></Query><Fields><Field Name="Disease"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Хвороба].[Хвороба].[Хвороба]&quot; /&gt;</DataField></Field><Field Name="Cases"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Випадки лікування]&quot; /&gt;</DataField></Field><Field Name="Eff"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Ефективність лікування]&quot; /&gt;</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="tb1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Дашборд поліклініки</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Рік: &quot; &amp; Parameters!Year.Label &amp; &quot; · показники порівнюються з цілями KPI та попереднім роком&quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#595959</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.9cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Rectangle Name="rectKpiEff"><ReportItems><Textbox Name="tb3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ефективність лікування</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#595959</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.1cm</Top><Left>0.15cm</Left><Height>0.5cm</Height><Width>4cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!EffValue.Value, &quot;dsKpi&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Format>0.0%</Format><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.6cm</Top><Left>0.15cm</Left><Height>1cm</Height><Width>2.9cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>●</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>22pt</FontSize><Color>=Switch(First(Fields!EffStatus.Value, &quot;dsKpi&quot;) = 1, &quot;#3BA55C&quot;, First(Fields!EffStatus.Value, &quot;dsKpi&quot;) = 0, &quot;#F2C80F&quot;, True, &quot;#E04B4B&quot;)</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><ToolTip>Статус KPI: зелений — ціль досягнуто, жовтий — близько до цілі, червоний — нижче цілі</ToolTip><Top>0.65cm</Top><Left>3.1cm</Left><Height>1cm</Height><Width>0.9cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb6"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Ціль: &quot; &amp; Format(First(Fields!EffGoal.Value, &quot;dsKpi&quot;), &quot;0%&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#7F7F7F</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>1.65cm</Top><Left>0.15cm</Left><Height>0.45cm</Height><Width>4cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Top>1.6cm</Top><Left>0cm</Left><Height>2.2cm</Height><Width>4.3cm</Width><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#F7F9FC</BackgroundColor></Style></Rectangle><Rectangle Name="rectKpiNorm"><ReportItems><Textbox Name="tb7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Дотримання нормативу</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#595959</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.1cm</Top><Left>0.15cm</Left><Height>0.5cm</Height><Width>4cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb8"><CanGrow>true</Can