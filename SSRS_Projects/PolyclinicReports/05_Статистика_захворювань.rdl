<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df"><df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily><AutoRefresh>0</AutoRefresh><Description>Звіт з деталізацією (OLAP): клас МКХ-10 → хвороба → вікова група, з розгортанням груп, навігаційною картою і переходом до списку пацієнтів (drillthrough).</Description><DataSources><DataSource Name="PolyclinicDW"><DataSourceReference>PolyclinicDW</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>5f170400-aadb-49a5-af83-e01def87b5ff</rd:DataSourceID></DataSource><DataSource Name="PolyclinicOLAP"><DataSourceReference>PolyclinicOLAP</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>a10731bb-3106-46c7-9593-6b83c2acf2b6</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="dsYears"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT YearNo, N'[Дата].[Рік].&amp;[' + CAST(YearNo AS nvarchar(4)) + N']' AS YearMdx, N'[Дата].[Календар].[Рік].&amp;[' + CAST(YearNo AS nvarchar(4)) + N']' AS YearCalMdx FROM dim.DimDate WHERE YearNo BETWEEN 2016 AND 2025 ORDER BY YearNo DESC</CommandText></Query><Fields><Field Name="YearNo"><DataField>YearNo</DataField><rd:TypeName>System.Int16</rd:TypeName></Field><Field Name="YearMdx"><DataField>YearMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="YearCalMdx"><DataField>YearCalMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsClasses"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT ICDChapter, ICDChapter + N' ' + CategoryName AS ClassLabel, N'[Хвороба].[Клас МКХ-10].&amp;[' + ICDChapter + N']' AS ClassMdx FROM dim.DimDisease WHERE DiseaseKey &gt; 0 ORDER BY ICDChapter</CommandText></Query><Fields><Field Name="ICDChapter"><DataField>ICDChapter</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ClassLabel"><DataField>ClassLabel</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ClassMdx"><DataField>ClassMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsStats"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="Classes"><Value>=Parameters!Classes.Value</Value></QueryParameter><QueryParameter Name="Years"><Value>=Parameters!Years.Value</Value></QueryParameter><QueryParameter Name="Genders"><Value>=Parameters!Genders.Value</Value></QueryParameter></QueryParameters><CommandText>
WITH MEMBER [Measures].[DiseaseKey] AS IIF(ISEMPTY([Measures].[Випадки лікування]), NULL, [Хвороба].[Хвороба].CURRENTMEMBER.MEMBER_KEY)
     MEMBER [Measures].[ClassCode] AS IIF(ISEMPTY([Measures].[Випадки лікування]), NULL, [Хвороба].[Клас МКХ-10].CURRENTMEMBER.MEMBER_KEY)
SELECT NON EMPTY { [Measures].[Випадки лікування], [Measures].[Дні лікування], [Measures].[Позитивні результати],
                   [Measures].[Ускладнення], [Measures].[Супутні захворювання], [Measures].[DiseaseKey], [Measures].[ClassCode] } ON COLUMNS,
NON EMPTY ( STRTOSET(@Classes, CONSTRAINED) * [Хвороба].[Хвороба].[Хвороба].ALLMEMBERS
          * [Вікова група].[Вікова група].[Вікова група].ALLMEMBERS ) ON ROWS
FROM ( SELECT ( STRTOSET(@Years, CONSTRAINED), STRTOSET(@Genders, CONSTRAINED) ) ON COLUMNS FROM [Поліклініка] )</CommandText></Query><Fields><Field Name="ClassName"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Хвороба].[Клас МКХ-10].[Клас МКХ-10]&quot; /&gt;</DataField></Field><Field Name="Disease"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Хвороба].[Хвороба].[Хвороба]&quot; /&gt;</DataField></Field><Field Name="AgeGroup"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Вікова група].[Вікова група].[Вікова група]&quot; /&gt;</DataField></Field><Field Name="Cases"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Випадки лікування]&quot; /&gt;</DataField></Field><Field Name="Days"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Дні лікування]&quot; /&gt;</DataField></Field><Field Name="Positive"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Позитивні результати]&quot; /&gt;</DataField></Field><Field Name="Complications"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Ускладнення]&quot; /&gt;</DataField></Field><Field Name="Comorbid"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Супутні захворювання]&quot; /&gt;</DataField></Field><Field Name="DiseaseKey"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[DiseaseKey]&quot; /&gt;</DataField></Field><Field Name="ClassCode"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[ClassCode]&quot; /&gt;</DataField></Field></Fields></DataSet><DataSet Name="dsClassesDefault"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT N'[Хвороба].[Клас МКХ-10].&amp;[' + ICDChapter + N']' AS ClassMdx FROM dim.DimDisease WHERE DiseaseKey &gt; 0 AND ICDChapter &lt;&gt; N'Z00-Z99'</CommandText></Query><Fields><Field Name="ClassMdx"><DataField>ClassMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="tb1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Статистика захворювань</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Роки: &quot; &amp; Join(Parameters!Years.Label, &quot;, &quot;) &amp; &quot; · стать: &quot; &amp; Join(Parameters!Genders.Label, &quot;, &quot;) &amp; &quot; · натисніть «+», щоб розгорнути клас і хворобу; назва хвороби відкриває список пацієнтів&quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#595959</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.9cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Tablix Name="tblStats"><TablixBody><TablixColumns><TablixColumn><Width>11.2cm</Width></TablixColumn><TablixColumn><Width>2.4cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>2.6cm</Width></TablixColumn><TablixColumn><Width>2.6cm</Width></TablixColumn><TablixColumn><Width>2.8cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="tb3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Клас МКХ-10 / хвороба / вікова група</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Випадки</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Сер. тривалість, днів</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb6"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ефективність</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ускладнення</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb8"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Супутні діагнози</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="tbClass"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ClassCode.Value &amp; &quot; &quot; &amp; Fields!ClassName.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><ToggleImage><InitialState>false</InitialState></ToggleImage><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb9"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Cases.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Format>#,##0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb10"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Sum(Fields!Cases.Value) = 0, Nothing, Sum(Fields!Days.Value) / Sum(Fields!Cases.Value))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Format>0.0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb11"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Sum(Fields!Cases.Value) = 0, Nothing, Sum(Fields!Positive.Value) / Sum(Fields!Cases.Value))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Format>0.0%</Format><Color>=IIF(Sum(Fields!Positive.Value) / Sum(Fields!Cases.Value) &lt; 0.7, &quot;#C00000&quot;, IIF(Sum(Fields!Positive.Value) / Sum(Fields!Cases.Value) &gt;= 0.85, &quot;#2E7D32&quot;, &quot;Black&quot;))</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb12"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Complications.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Format>#,##0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb13"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Comorbid.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Format>#,##0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="tbDisease"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Disease.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><ToggleImage><InitialState>false</InitialState></ToggleImage><ActionInfo><Actions><Action><Drillthrough><ReportName>07_Пацієнти_з_діагнозом</ReportName><Parameters><Parameter Name="DiseaseKey"><Value>=CInt(Fields!DiseaseKey.Value)</Value></Parameter><Parameter Name="Years"><Value>=Parameters!Years.Label</Value></Parameter></Parameters></Drillthrough></Action></Actions></ActionInfo><ToolTip>Відкрити список пацієнтів з цим діагнозом</ToolTip><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#EEF3F9</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb14"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Cases.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>#,##0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#EEF3F9</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><P