<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df"><df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily><AutoRefresh>0</AutoRefresh><Description>Звіт з діаграмами (OLAP): ефективність за класами МКХ-10 (стовпчикова), динаміка по роках (лінійна), структура результатів (кругова), найкращі лікарі (горизонтальна); таблиця з умовним форматуванням.</Description><DataSources><DataSource Name="PolyclinicDW"><DataSourceReference>PolyclinicDW</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>a00b14d0-6aa7-402d-88eb-fbf25a298b5e</rd:DataSourceID></DataSource><DataSource Name="PolyclinicOLAP"><DataSourceReference>PolyclinicOLAP</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>58150a5e-93c7-4989-8ff6-2c68a2bf555e</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="dsYears"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT YearNo, N'[Дата].[Рік].&amp;[' + CAST(YearNo AS nvarchar(4)) + N']' AS YearMdx, N'[Дата].[Календар].[Рік].&amp;[' + CAST(YearNo AS nvarchar(4)) + N']' AS YearCalMdx FROM dim.DimDate WHERE YearNo BETWEEN 2016 AND 2025 ORDER BY YearNo DESC</CommandText></Query><Fields><Field Name="YearNo"><DataField>YearNo</DataField><rd:TypeName>System.Int16</rd:TypeName></Field><Field Name="YearMdx"><DataField>YearMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="YearCalMdx"><DataField>YearCalMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsClasses"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT ICDChapter, ICDChapter + N' ' + CategoryName AS ClassLabel, N'[Хвороба].[Клас МКХ-10].&amp;[' + ICDChapter + N']' AS ClassMdx FROM dim.DimDisease WHERE DiseaseKey &gt; 0 ORDER BY ICDChapter</CommandText></Query><Fields><Field Name="ICDChapter"><DataField>ICDChapter</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ClassLabel"><DataField>ClassLabel</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ClassMdx"><DataField>ClassMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsByClass"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="Years"><Value>=Parameters!Years.Value</Value></QueryParameter><QueryParameter Name="Classes"><Value>=Parameters!Classes.Value</Value></QueryParameter><QueryParameter Name="IncludeZ"><Value>=CStr(Parameters!IncludePreventive.Value)</Value></QueryParameter></QueryParameters><CommandText>
WITH MEMBER [Measures].[ClassCode] AS IIF(ISEMPTY([Measures].[Випадки лікування]), NULL, [Хвороба].[Клас МКХ-10].CURRENTMEMBER.MEMBER_KEY)
SELECT NON EMPTY { [Measures].[Випадки лікування], [Measures].[Ефективність лікування], [Measures].[Рівень одужання],
                   [Measures].[Дотримання нормативу], [Measures].[Середня тривалість лікування], [Measures].[ClassCode] } ON COLUMNS,
NON EMPTY [Хвороба].[Клас МКХ-10].[Клас МКХ-10].ALLMEMBERS ON ROWS
FROM ( SELECT ( STRTOSET(@Years, CONSTRAINED), FILTER(STRTOSET(@Classes, CONSTRAINED), @IncludeZ = &quot;True&quot; OR NOT ([Хвороба].[Клас МКХ-10].CURRENTMEMBER IS [Хвороба].[Клас МКХ-10].&amp;[Z00-Z99])) ) ON COLUMNS FROM [Поліклініка] )</CommandText></Query><Fields><Field Name="ClassName"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Хвороба].[Клас МКХ-10].[Клас МКХ-10]&quot; /&gt;</DataField></Field><Field Name="Cases"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Випадки лікування]&quot; /&gt;</DataField></Field><Field Name="Eff"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Ефективність лікування]&quot; /&gt;</DataField></Field><Field Name="Recovery"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Рівень одужання]&quot; /&gt;</DataField></Field><Field Name="Norm"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Дотримання нормативу]&quot; /&gt;</DataField></Field><Field Name="AvgDays"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Середня тривалість лікування]&quot; /&gt;</DataField></Field><Field Name="ClassCode"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[ClassCode]&quot; /&gt;</DataField></Field></Fields></DataSet><DataSet Name="dsByYear"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="Years"><Value>=Parameters!Years.Value</Value></QueryParameter><QueryParameter Name="Classes"><Value>=Parameters!Classes.Value</Value></QueryParameter><QueryParameter Name="IncludeZ"><Value>=CStr(Parameters!IncludePreventive.Value)</Value></QueryParameter></QueryParameters><CommandText>
SELECT NON EMPTY { [Measures].[Ефективність лікування], [Measures].[Рівень одужання], [Measures].[Дотримання нормативу] } ON COLUMNS,
NON EMPTY [Дата].[Рік].[Рік].ALLMEMBERS ON ROWS
FROM ( SELECT ( STRTOSET(@Years, CONSTRAINED), FILTER(STRTOSET(@Classes, CONSTRAINED), @IncludeZ = &quot;True&quot; OR NOT ([Хвороба].[Клас МКХ-10].CURRENTMEMBER IS [Хвороба].[Клас МКХ-10].&amp;[Z00-Z99])) ) ON COLUMNS FROM [Поліклініка] )</CommandText></Query><Fields><Field Name="Year"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Дата].[Рік].[Рік]&quot; /&gt;</DataField></Field><Field Name="Eff"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Ефективність лікування]&quot; /&gt;</DataField></Field><Field Name="Recovery"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Рівень одужання]&quot; /&gt;</DataField></Field><Field Name="Norm"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Дотримання нормативу]&quot; /&gt;</DataField></Field></Fields></DataSet><DataSet Name="dsOutcome"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="Years"><Value>=Parameters!Years.Value</Value></QueryParameter><QueryParameter Name="Classes"><Value>=Parameters!Classes.Value</Value></QueryParameter><QueryParameter Name="IncludeZ"><Value>=CStr(Parameters!IncludePreventive.Value)</Value></QueryParameter></QueryParameters><CommandText>
SELECT NON EMPTY { [Measures].[Випадки лікування] } ON COLUMNS,
NON EMPTY [Результат лікування].[Результат].[Результат].ALLMEMBERS ON ROWS
FROM ( SELECT ( STRTOSET(@Years, CONSTRAINED), FILTER(STRTOSET(@Classes, CONSTRAINED), @IncludeZ = &quot;True&quot; OR NOT ([Хвороба].[Клас МКХ-10].CURRENTMEMBER IS [Хвороба].[Клас МКХ-10].&amp;[Z00-Z99])) ) ON COLUMNS FROM [Поліклініка] )</CommandText></Query><Fields><Field Name="Outcome"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Результат лікування].[Результат].[Результат]&quot; /&gt;</DataField></Field><Field Name="Cases"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Випадки лікування]&quot; /&gt;</DataField></Field></Fields></DataSet><DataSet Name="dsTopDoctors"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="Years"><Value>=Parameters!Years.Value</Value></QueryParameter><QueryParameter Name="Classes"><Value>=Parameters!Classes.Value</Value></QueryParameter><QueryParameter Name="IncludeZ"><Value>=CStr(Parameters!IncludePreventive.Value)</Value></QueryParameter></QueryParameters><CommandText>
SELECT { [Measures].[Ефективність лікування], [Measures].[Випадки лікування] } ON COLUMNS,
TOPCOUNT(FILTER([Лікар].[Лікар].[Лікар].ALLMEMBERS, [Measures].[Випадки лікування] &gt;= 300), 10, [Measures].[Ефективність лікування]) ON ROWS
FROM ( SELECT ( STRTOSET(@Years, CONSTRAINED), FILTER(STRTOSET(@Classes, CONSTRAINED), @IncludeZ = &quot;True&quot; OR NOT ([Хвороба].[Клас МКХ-10].CURRENTMEMBER IS [Хвороба].[Клас МКХ-10].&amp;[Z00-Z99])) ) ON COLUMNS FROM [Поліклініка] )</CommandText></Query><Fields><Field Name="Doctor"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Лікар].[Лікар].[Лікар]&quot; /&gt;</DataField></Field><Field Name="Eff"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Ефективність лікування]&quot; /&gt;</DataField></Field><Field Name="Cases"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Випадки лікування]&quot; /&gt;</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="tb1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Аналіз ефективності лікування</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Роки: &quot; &amp; Join(Parameters!Years.Label, &quot;, &quot;) &amp; IIF(Parameters!IncludePreventive.Value, &quot;&quot;, &quot; · без профілактичних звернень&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#595959</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.9cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Chart Name="chClasses"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="chClasses_Cat"><GroupExpressions><GroupExpression>=Fields!ClassCode.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!ClassCode.Value</Value></SortExpression></SortExpressions><Label>=Fields!ClassCode.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Label>Ефективність</Label></ChartMember><ChartMember><Label>Одужання</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="chClasses_S0"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!Eff.Value)</Y></ChartDataPointValues><ChartDataLabel><Style /></ChartDataLabel><Style><Color>#4472C4</Color></Style><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Column</Type><Subtype>Plain</Subtype><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style /></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries><ChartSeries Name="chClasses_S1"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!Recovery.Value)</Y></ChartDataPointValues><ChartDataLabel><Style /></ChartDataLabel><Style><Color>#A5A5A5</Color></Style><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Column</Type><Subtype>Plain</Subtype><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style /></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries></ChartSeriesCollection></ChartData><ChartAreas><ChartArea Name="Default"><ChartCategoryAxes><ChartAxis Name="Primary"><Style><FontSize>7pt</FontSize></Style><ChartAxisTitle><Caption /><Style><FontSize>8pt</FontSize></Style></ChartAxisTitle><ChartMajorGridLines><Enabled>False</Enabled><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><Interval>1</Interval><LabelsAutoFitDisabled>false</LabelsAutoFitDisabled><ChartMinorTickMarks><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><PreventFontShrink>false</PreventFontShrink></ChartAxis></ChartCategoryAxes><ChartValueAxes><ChartAxis Name="Primary"><Style><FontSize>7pt</FontSize><Format>0%</Format></Style><ChartAxisTitle><Caption /><Style><FontSize>8pt</FontSize></Style></ChartAxisTitle><ChartMajorGridLines><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><Maximum>1</Maximum><ChartMinorTickMarks><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><PreventFontShrink>false</PreventFontShrink></ChartAxis></ChartValueAxes><Style><BackgroundColor>#FFFFFF</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType></Style></ChartArea></