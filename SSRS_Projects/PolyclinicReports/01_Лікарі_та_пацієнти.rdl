<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df"><df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily><AutoRefresh>0</AutoRefresh><Description>Табличний звіт: пацієнти кожного лікаря за період з підсумками по лікарях і відділеннях. Каскадні параметри Відділення → Спеціальність → Лікар, діапазон дат, перемикач «лише хронічні».</Description><DataSources><DataSource Name="PolyclinicDW"><DataSourceReference>PolyclinicDW</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>2178a8a9-0bd5-4a79-9bda-9f23359efffe</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="dsDepartments"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT Department FROM dim.DimDoctor WHERE DoctorKey &gt; 0 ORDER BY Department</CommandText></Query><Fields><Field Name="Department"><DataField>Department</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsSpecialties"><Query><DataSourceName>PolyclinicDW</DataSourceName><QueryParameters><QueryParameter Name="@Department"><Value>=Parameters!Department.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT DISTINCT Specialty FROM dim.DimDoctor WHERE DoctorKey &gt; 0 AND Department IN (@Department) ORDER BY Specialty</CommandText></Query><Fields><Field Name="Specialty"><DataField>Specialty</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsDoctors"><Query><DataSourceName>PolyclinicDW</DataSourceName><QueryParameters><QueryParameter Name="@Department"><Value>=Parameters!Department.Value</Value></QueryParameter><QueryParameter Name="@Specialty"><Value>=Parameters!Specialty.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT DISTINCT DoctorID, ShortName + N' (' + Specialty + N')' AS DoctorLabel FROM dim.DimDoctor WHERE DoctorKey &gt; 0 AND IsCurrent = 1 AND Department IN (@Department) AND Specialty IN (@Specialty) ORDER BY DoctorLabel</CommandText></Query><Fields><Field Name="DoctorID"><DataField>DoctorID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="DoctorLabel"><DataField>DoctorLabel</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsMain"><Query><DataSourceName>PolyclinicDW</DataSourceName><QueryParameters><QueryParameter Name="@DateFrom"><Value>=Parameters!DateFrom.Value</Value></QueryParameter><QueryParameter Name="@DateTo"><Value>=Parameters!DateTo.Value</Value></QueryParameter><QueryParameter Name="@Doctor"><Value>=Parameters!Doctor.Value</Value></QueryParameter><QueryParameter Name="@OnlyChronic"><Value>=Parameters!OnlyChronic.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT doc.Department, doc.Specialty, doc.DoctorID, doc.ShortName AS Doctor, doc.Category,
       p.PatientID, p.FullName AS Patient, p.GenderName, p.BirthYear, p.City,
       COUNT(*) AS Visits, SUM(f.IsCompleted) AS CompletedVisits, SUM(f.Cost) AS Revenue,
       MIN(d.FullDate) AS FirstVisit, MAX(d.FullDate) AS LastVisit,
       MAX(CASE WHEN dis.IsChronic = 1 THEN 1 ELSE 0 END) AS HasChronic
FROM fact.FactVisit f
JOIN dim.DimDate d      ON d.DateKey = f.DateKey
JOIN dim.DimDoctor doc  ON doc.DoctorKey = f.DoctorKey
JOIN dim.DimPatient p   ON p.PatientKey = f.PatientKey
JOIN dim.DimDisease dis ON dis.DiseaseKey = f.DiseaseKey
WHERE d.FullDate BETWEEN @DateFrom AND @DateTo
  AND doc.DoctorID IN (@Doctor)
GROUP BY doc.Department, doc.Specialty, doc.DoctorID, doc.ShortName, doc.Category,
         p.PatientID, p.FullName, p.GenderName, p.BirthYear, p.City
HAVING @OnlyChronic = 0 OR MAX(CASE WHEN dis.IsChronic = 1 THEN 1 ELSE 0 END) = 1</CommandText></Query><Fields><Field Name="Department"><DataField>Department</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Specialty"><DataField>Specialty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DoctorID"><DataField>DoctorID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Doctor"><DataField>Doctor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Category"><DataField>Category</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PatientID"><DataField>PatientID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Patient"><DataField>Patient</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="GenderName"><DataField>GenderName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BirthYear"><DataField>BirthYear</DataField><rd:TypeName>System.Int16</rd:TypeName></Field><Field Name="City"><DataField>City</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Visits"><DataField>Visits</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="CompletedVisits"><DataField>CompletedVisits</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Revenue"><DataField>Revenue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="FirstVisit"><DataField>FirstVisit</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="LastVisit"><DataField>LastVisit</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="HasChronic"><DataField>HasChronic</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="tb1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Список лікарів та їх пацієнтів</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Період: &quot; &amp; Format(Parameters!DateFrom.Value, &quot;dd.MM.yyyy&quot;) &amp; &quot; – &quot; &amp; Format(Parameters!DateTo.Value, &quot;dd.MM.yyyy&quot;) &amp; IIF(Parameters!OnlyChronic.Value, &quot; · лише пацієнти з хронічними хворобами&quot;, &quot;&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#595959</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.9cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Помилка параметрів: дата початку періоду пізніша за дату кінця. Змініть діапазон дат.</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#C00000</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Visibility><Hidden>=Parameters!DateFrom.Value &lt;= Parameters!DateTo.Value</Hidden></Visibility><Top>1.6cm</Top><Left>0cm</Left><Height>0.8cm</Height><Width>27.3cm</Width><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#FDE9E9</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Tablix Name="tblDoctorPatients"><TablixBody><TablixColumns><TablixColumn><Width>6.5cm</Width></TablixColumn><TablixColumn><Width>1.8cm</Width></TablixColumn><TablixColumn><Width>1.6cm</Width></TablixColumn><TablixColumn><Width>3.2cm</Width></TablixColumn><TablixColumn><Width>1.8cm</Width></TablixColumn><TablixColumn><Width>1.9cm</Width></TablixColumn><TablixColumn><Width>2.6cm</Width></TablixColumn><TablixColumn><Width>2.3cm</Width></TablixColumn><TablixColumn><Width>2.3cm</Width></TablixColumn><TablixColumn><Width>1.8cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="tb4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Пацієнт</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><UserSort><SortExpression>=Fields!Patient.Value</SortExpression></UserSort><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Стать</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb6"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Рік нар.</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><UserSort><SortExpression>=Fields!BirthYear.Value</SortExpression></UserSort><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Місто</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><UserSort><SortExpression>=Fields!City.Value</SortExpression></UserSort><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb8"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Візитів</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><UserSort><SortExpression>=Fields!Visits.Value</SortExpression></UserSort><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb9"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Відбулися</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb10"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Сума, грн</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><UserSort><SortExpression>=Fields!Revenue.Value</SortExpression></UserSort><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents