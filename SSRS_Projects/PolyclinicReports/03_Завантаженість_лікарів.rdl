<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df"><df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily><AutoRefresh>0</AutoRefresh><Description>Матричний звіт з OLAP-куба: проведені візити лікар × місяць, теплова карта завантаженості, підказка з годинами прийому та виручкою.</Description><DataSources><DataSource Name="PolyclinicDW"><DataSourceReference>PolyclinicDW</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>9d6aa910-32cc-4762-add2-ffc7c3720c20</rd:DataSourceID></DataSource><DataSource Name="PolyclinicOLAP"><DataSourceReference>PolyclinicOLAP</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>2bb38836-d842-44f0-b915-5b32e71b1927</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="dsYears"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT YearNo, N'[Дата].[Рік].&amp;[' + CAST(YearNo AS nvarchar(4)) + N']' AS YearMdx, N'[Дата].[Календар].[Рік].&amp;[' + CAST(YearNo AS nvarchar(4)) + N']' AS YearCalMdx FROM dim.DimDate WHERE YearNo BETWEEN 2016 AND 2025 ORDER BY YearNo DESC</CommandText></Query><Fields><Field Name="YearNo"><DataField>YearNo</DataField><rd:TypeName>System.Int16</rd:TypeName></Field><Field Name="YearMdx"><DataField>YearMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="YearCalMdx"><DataField>YearCalMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsDepartments"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DISTINCT Department, N'[Лікар].[Відділення].&amp;[' + Department + N']' AS DeptMdx FROM dim.DimDoctor WHERE DoctorKey &gt; 0 ORDER BY Department</CommandText></Query><Fields><Field Name="Department"><DataField>Department</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DeptMdx"><DataField>DeptMdx</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsWorkload"><Query><DataSourceName>PolyclinicOLAP</DataSourceName><QueryParameters><QueryParameter Name="Department"><Value>=Parameters!Department.Value</Value></QueryParameter><QueryParameter Name="Year"><Value>=Parameters!Year.Value</Value></QueryParameter></QueryParameters><CommandText>
WITH MEMBER [Measures].[MonthNo] AS IIF(ISEMPTY([Measures].[Проведені візити]), NULL, [Дата].[Місяць року].CURRENTMEMBER.MEMBER_KEY)
SELECT NON EMPTY { [Measures].[Проведені візити], [Measures].[Хвилини прийомів], [Measures].[Виручка], [Measures].[MonthNo] } ON COLUMNS,
NON EMPTY ( STRTOSET(@Department, CONSTRAINED) * [Лікар].[Лікар].[Лікар].ALLMEMBERS * [Дата].[Місяць року].[Місяць року].ALLMEMBERS ) ON ROWS
FROM ( SELECT STRTOSET(@Year, CONSTRAINED) ON COLUMNS FROM [Поліклініка] )</CommandText></Query><Fields><Field Name="Department"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Лікар].[Відділення].[Відділення]&quot; /&gt;</DataField></Field><Field Name="Doctor"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Лікар].[Лікар].[Лікар]&quot; /&gt;</DataField></Field><Field Name="Month"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Level&quot; UniqueName=&quot;[Дата].[Місяць року].[Місяць року]&quot; /&gt;</DataField></Field><Field Name="Visits"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Проведені візити]&quot; /&gt;</DataField></Field><Field Name="Minutes"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Хвилини прийомів]&quot; /&gt;</DataField></Field><Field Name="Revenue"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[Виручка]&quot; /&gt;</DataField></Field><Field Name="MonthNo"><DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[MonthNo]&quot; /&gt;</DataField></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="tb1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Завантаженість лікарів по місяцях</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Рік: &quot; &amp; Parameters!Year.Label &amp; &quot; · кількість проведених візитів; наведіть курсор на комірку, щоб побачити години прийому та виручку&quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#595959</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.9cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Tablix Name="mtxWorkload"><TablixCorner><TablixCornerRows><TablixCornerRow><TablixCornerCell><CellContents><Textbox Name="tb10"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Відділення</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell><TablixCornerCell><CellContents><Textbox Name="tb11"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Лікар</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell></TablixCornerRow></TablixCornerRows></TablixCorner><TablixBody><TablixColumns><TablixColumn><Width>1.3cm</Width></TablixColumn><TablixColumn><Width>1.3cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="tb3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Visits.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Format>#,##0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><ToolTip>=&quot;Години прийому: &quot; &amp; Format(Sum(Fields!Minutes.Value) / 60, &quot;#,##0.0&quot;) &amp; &quot; · виручка: &quot; &amp; Format(Sum(Fields!Revenue.Value), &quot;#,##0&quot;) &amp; &quot; грн&quot;</ToolTip><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>=Switch(Sum(Fields!Visits.Value) &gt;= 300, &quot;#F8696B&quot;, Sum(Fields!Visits.Value) &gt;= 220, &quot;#FCB273&quot;, Sum(Fields!Visits.Value) &gt;= 150, 