<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df"><df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily><AutoRefresh>0</AutoRefresh><Description>Список закритих випадків лікування з вибраним основним діагнозом (відкривається зі звіту «Статистика захворювань»).</Description><DataSources><DataSource Name="PolyclinicDW"><DataSourceReference>PolyclinicDW</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>7e148ce4-6224-489b-b89a-f9ee0ec2b696</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="dsDiseases"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT DiseaseKey, DiseaseFullName FROM dim.DimDisease WHERE DiseaseKey &gt; 0 ORDER BY ICDCode</CommandText></Query><Fields><Field Name="DiseaseKey"><DataField>DiseaseKey</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="DiseaseFullName"><DataField>DiseaseFullName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsDefaultDisease"><Query><DataSourceName>PolyclinicDW</DataSourceName><CommandText>SELECT TOP (1) DiseaseKey FROM fact.FactTreatment GROUP BY DiseaseKey ORDER BY COUNT(*) DESC</CommandText></Query><Fields><Field Name="DiseaseKey"><DataField>DiseaseKey</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsCases"><Query><DataSourceName>PolyclinicDW</DataSourceName><QueryParameters><QueryParameter Name="@DiseaseKey"><Value>=Parameters!DiseaseKey.Value</Value></QueryParameter><QueryParameter Name="@Years"><Value>=Parameters!Years.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT p.FullName AS Patient, p.GenderName, ag.AgeGroup, p.City, od.FullDate AS OpenDate, cd.FullDate AS CloseDate,
       f.TreatmentDays, f.NormTreatmentDays, o.Outcome, o.IsPositive, doc.ShortName + N' (' + doc.Specialty + N')' AS Doctor,
       f.ComorbidityCount, dis.DiseaseFullName
FROM fact.FactTreatment f
JOIN dim.DimPatient p   ON p.PatientKey = f.PatientKey
JOIN dim.DimAgeGroup ag ON ag.AgeGroupKey = f.AgeGroupKey
JOIN dim.DimDate od     ON od.DateKey = f.OpenDateKey
JOIN dim.DimDate cd     ON cd.DateKey = f.CloseDateKey
JOIN dim.DimOutcome o   ON o.OutcomeKey = f.OutcomeKey
JOIN dim.DimDoctor doc  ON doc.DoctorKey = f.DoctorKey
JOIN dim.DimDisease dis ON dis.DiseaseKey = f.DiseaseKey
WHERE f.DiseaseKey = @DiseaseKey AND cd.YearNo IN (@Years)</CommandText></Query><Fields><Field Name="Patient"><DataField>Patient</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="GenderName"><DataField>GenderName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AgeGroup"><DataField>AgeGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="City"><DataField>City</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OpenDate"><DataField>OpenDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="CloseDate"><DataField>CloseDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="TreatmentDays"><DataField>TreatmentDays</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="NormTreatmentDays"><DataField>NormTreatmentDays</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Outcome"><DataField>Outcome</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="IsPositive"><DataField>IsPositive</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="Doctor"><DataField>Doctor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ComorbidityCount"><DataField>ComorbidityCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="DiseaseFullName"><DataField>DiseaseFullName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="tb1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Пацієнти з діагнозом</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>27.3cm</Width><Style><VerticalAlign>Middle</VerticalAli