<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df"><df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily><AutoRefresh>0</AutoRefresh><Description>Картка пацієнта та всі історії хвороб з діагнозами, візитами і призначеними ліками (вкладений звіт). Каскадний пошук: прізвище → пацієнт.</Description><DataSources><DataSource Name="PolyclinicDB"><DataSourceReference>PolyclinicDB</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>b8675fc3-79c4-4704-8f48-d13c414cfce3</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="dsPatients"><Query><DataSourceName>PolyclinicDB</DataSourceName><QueryParameters><QueryParameter Name="@LastName"><Value>=Parameters!LastName.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT TOP (500) PatientID, LastName + N' ' + FirstName + ISNULL(N' ' + MiddleName, N'') + N' (' + CONVERT(nvarchar(10), BirthDate, 104) + N')' AS PatientLabel FROM dbo.Patients WHERE LastName LIKE @LastName + N'%' ORDER BY LastName, FirstName, BirthDate</CommandText></Query><Fields><Field Name="PatientID"><DataField>PatientID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="PatientLabel"><DataField>PatientLabel</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsPatient"><Query><DataSourceName>PolyclinicDB</DataSourceName><QueryParameters><QueryParameter Name="@Patient"><Value>=Parameters!Patient.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT p.PatientID, p.LastName + N' ' + p.FirstName + ISNULL(N' ' + p.MiddleName, N'') AS FullName, p.BirthDate,
       dbo.fn_Age(p.BirthDate, CAST(GETDATE() AS date)) AS Age,
       CASE p.Gender WHEN 'F' THEN N'жінка' ELSE N'чоловік' END AS Gender,
       c.Name + ISNULL(N', ' + p.Address, N'') AS Address, ISNULL(p.Phone, N'—') AS Phone,
       ISNULL(p.InsurancePolicy, N'немає') AS Policy, ISNULL(p.BloodType, N'невідома') AS BloodType, p.RegistrationDate,
       (SELECT COUNT(*) FROM dbo.MedicalRecords r WHERE r.PatientID = p.PatientID) AS Records,
       (SELECT COUNT(*) FROM dbo.Visits v JOIN dbo.MedicalRecords r ON r.RecordID = v.RecordID WHERE r.PatientID = p.PatientID) AS Visits
FROM dbo.Patients p JOIN dbo.Cities c ON c.CityID = p.CityID
WHERE p.PatientID = @Patient</CommandText></Query><Fields><Field Name="PatientID"><DataField>PatientID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="FullName"><DataField>FullName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BirthDate"><DataField>BirthDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Age"><DataField>Age</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Gender"><DataField>Gender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Address"><DataField>Address</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Phone"><DataField>Phone</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Policy"><DataField>Policy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BloodType"><DataField>BloodType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RegistrationDate"><DataField>RegistrationDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Records"><DataField>Records</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Visits"><DataField>Visits</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsHistory"><Query><DataSourceName>PolyclinicDB</DataSourceName><QueryParameters><QueryParameter Name="@Patient"><Value>=Parameters!Patient.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT r.RecordID, r.OpenDate, r.CloseDate, r.Status, r.Outcome,
       ds.ICDCode + N' ' + ds.Name AS MainDiagnosis,
       STUFF((SELECT N'; ' + d2.ICDCode + N' ' + d2.Name + N' (' + LOWER(x.DiagnosisType) + N')'
              FROM dbo.Diagnoses x JOIN dbo.Diseases d2 ON d2.DiseaseID = x.DiseaseID
              WHERE x.RecordID = r.RecordID AND x.DiagnosisType &lt;&gt; N'Основний'
              FOR XML PATH(''), TYPE).value('.', 'nvarchar(max)'), 1, 2, N'') AS OtherDiagnoses,
       ad.LastName + N' ' + LEFT(ad.FirstName, 1) + N'.' AS AttendingDoctor,
       v.VisitID, v.VisitDateTime, v.VisitType, v.Status AS VisitStatus,
       vd.LastName + N' ' + LEFT(vd.FirstName, 1) + N'. (' + sp.Name + N')' AS VisitDoctor,
       v.Cost, v.Complaints, (SELECT COUNT(*) FROM dbo.Prescriptions pr WHERE pr.VisitID = v.VisitID) AS PrescriptionCount
FROM dbo.MedicalRecords r
JOIN dbo.Diagnoses dg  ON dg.RecordID = r.RecordID AND dg.DiagnosisType = N'Основний'
JOIN dbo.Diseases ds   ON ds.DiseaseID = dg.DiseaseID
JOIN dbo.Doctors ad    ON ad.DoctorID = r.AttendingDoctorID
JOIN dbo.Visits v      ON v.RecordID = r.RecordID
JOIN dbo.Doctors vd    ON vd.DoctorID = v.DoctorID
JOIN dbo.Specialties sp ON sp.SpecialtyID = vd.SpecialtyID
WHERE r.PatientID = @Patient</CommandText></Query><Fields><Field Name="RecordID"><DataField>RecordID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="OpenDate"><DataField>OpenDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="CloseDate"><DataField>CloseDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Outcome"><DataField>Outcome</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="MainDiagnosis"><DataField>MainDiagnosis</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OtherDiagnoses"><DataField>OtherDiagnoses</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AttendingDoctor"><DataField>AttendingDoctor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="VisitID"><DataField>VisitID</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="VisitDateTime"><DataField>VisitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="VisitType"><DataField>VisitType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="VisitStatus"><DataField>VisitStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="VisitDoctor"><DataField>VisitDoctor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Cost"><DataField>Cost</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="Complaints"><DataField>Complaints</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PrescriptionCount"><DataField>PrescriptionCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Textbox Name="tb1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Історія хвороби пацієнта</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F4E79</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>0cm</Left><Height>0.9cm</Height><Width>18.6cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Пацієнт: &quot; &amp; First(Fields!FullName.Value, &quot;dsPatient&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#595959</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.9cm</Top><Left>0cm</Left><Height>0.6cm</Height><Width>18.6cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Rectangle Name="rectCard"><ReportItems><Textbox Name="tb3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Дата народження: &quot; &amp; Format(First(Fields!BirthDate.Value, &quot;dsPatient&quot;), &quot;dd.MM.yyyy&quot;) &amp; &quot; (&quot; &amp; First(Fields!Age.Value, &quot;dsPatient&quot;) &amp; &quot; р.) · стать: &quot; &amp; First(Fields!Gender.Value, &quot;dsPatient&quot;) &amp; &quot; · група крові: &quot; &amp; First(Fields!BloodType.Value, &quot;dsPatient&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.15cm</Top><Left>0.2cm</Left><Height>0.55cm</Height><Width>18.2cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Адреса: &quot; &amp; First(Fields!Address.Value, &quot;dsPatient&quot;) &amp; &quot; · телефон: &quot; &amp; First(Fields!Phone.Value, &quot;dsPatient&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.7cm</Top><Left>0.2cm</Left><Height>0.55cm</Height><Width>18.2cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><Textbox Name="tb5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Страховий поліс: &quot; &amp; First(Fields!Policy.Value, &quot;dsPatient&quot;) &amp; &quot; · прикріплений з &quot; &amp; Format(First(Fields!RegistrationDate.Value, &quot;dsPatient&quot;), &quot;dd.MM.yyyy&quot;) &amp; &quot; · історій хвороби: &quot; &amp; First(Fields!Records.Value, &quot;dsPatient&quot;) &amp; &quot; · візитів: &quot; &amp; First(Fields!Visits.Value, &quot;dsPatient&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>1.25cm</Top><Left>0.2cm</Left><Height>0.55cm</Height><Width>18.2cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Top>1.6cm</Top><Left>0cm</Left><Height>1.95cm</Height><Width>18.6cm</Width><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#EEF3F9</BackgroundColor></Style></Rectangle><Tablix Name="tblHistory"><TablixBody><TablixColumns><TablixColumn><Width>2.7cm</Width></TablixColumn><TablixColumn><Width>2.1cm</Width></TablixColumn><TablixColumn><Width>1.9cm</Width></TablixColumn><TablixColumn><Width>4.6cm</Width></TablixColumn><TablixColumn><Width>4.1cm</Width></TablixColumn><TablixColumn><Width>1.7cm</Width></TablixColumn><TablixColumn><Width>1.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="tb6"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Дата і час</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Тип візиту</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb8"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Статус</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb9"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Лікар</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb10"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Скарги</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb11"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Вартість</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="tb12"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ліків</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#1F4E79</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="tbRecord"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;№ &quot; &amp; Fields!RecordID.Value &amp; &quot; · &quot; &amp; Format(Fields!OpenDate.Value, &quot;dd.MM.yyyy&quot;) &amp; &quot; – &quot; &amp; IIF(IsNothing(Fields!CloseDate.Value), &quot;триває&quot;, Format(Fields!CloseDate.Value, &quot;dd.MM.yyyy&quot;))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><ToggleImage><InitialState>true</InitialState></ToggleImage><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>3</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell><CellContents><Textbox Name="tb13"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!MainDiagnosis.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell><CellContents><Textbox Name="tb14"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Fields!Status.Value = &quot;Відкрита&quot;, &quot;Відкрита&quot;, Fields!Outcome.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>=Switch(Fields!Status.Value = &quot;Відкрита&quot;, &quot;#1F4E79&quot;, Fields!Outcome.Value = &quot;Одужання&quot;, &quot;#2E7D32&quot;, Fields!Outcome.Value = &quot;Покращення&quot;, &quot;#558B2F&quot;, Fields!Outcome.Value = &quot;Погіршення&quot; Or Fields!Outcome.Value = &quot;Госпіталізація&quot;, &quot;#C00000&quot;, True, &quot;#595959&quot;)</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#BFBFBF</Color><Style>Solid</Style></Border><BackgroundColor>#D6E4F0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><Padding