    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{3FCD22C6-7BAB-4056-B2B9-98075941E09C}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT v.VisitID, v.RecordID, CAST(v.VisitDateTime AS date) AS VisitDate, DATEPART(HOUR, v.VisitDateTime) AS VisitHourRaw, r.PatientID, v.DoctorID, dg.DiseaseID, v.VisitType, v.Status AS VisitStatus, v.DurationMin, CAST(v.Cost AS decimal(12,2)) AS Cost, DATEDIFF(YEAR, p.BirthDate, CAST(v.VisitDateTime AS date)) - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.BirthDate, CAST(v.VisitDateTime AS date)), p.BirthDate) &gt; CAST(v.VisitDateTime AS date) THEN 1 ELSE 0 END AS AgeAtEvent, ISNULL(pr.Cnt, 0) AS PrescriptionCount, CAST(ISNULL(pr.Total, 0) AS decimal(12,2)) AS MedicationCost FROM dbo.Visits v JOIN dbo.MedicalRecords r ON r.RecordID = v.RecordID JOIN dbo.Patients p ON p.PatientID = r.PatientID JOIN dbo.Diagnoses dg ON dg.RecordID = r.RecordID AND dg.DiagnosisType = N'Основний' OUTER APPLY (SELECT COUNT(*) AS Cnt, SUM(x.TotalCost) AS Total FROM dbo.Prescriptions x WHERE x.VisitID = v.VisitID) pr WHERE v.VisitID &gt; &quot; + @[User::LastVisitID]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlVisits">
      <DTS:VariableValue
        DTS:DataType="8">SELECT v.VisitID, v.RecordID, CAST(v.VisitDateTime AS date) AS VisitDate, DATEPART(HOUR, v.VisitDateTime) AS VisitHourRaw, r.PatientID, v.DoctorID, dg.DiseaseID, v.VisitType, v.Status AS VisitStatus, v.DurationMin, CAST(v.Cost AS decimal(12,2)) AS Cost, DATEDIFF(YEAR, p.BirthDate, CAST(v.VisitDateTime AS date)) - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.BirthDate, CAST(v.VisitDateTime AS date)), p.BirthDate) &gt; CAST(v.VisitDateTime AS date) THEN 1 ELSE 0 END AS AgeAtEvent, ISNULL(pr.Cnt, 0) AS PrescriptionCount, CAST(ISNULL(pr.Total, 0) AS decimal(12,2)) AS MedicationCost FROM dbo.Visits v JOIN dbo.MedicalRecords r ON r.RecordID = v.RecordID JOIN dbo.Patients p ON p.PatientID = r.PatientID JOIN dbo.Diagnoses dg ON dg.RecordID = r.RecordID AND dg.DiagnosisType = N'Основний' OUTER APPLY (SELECT COUNT(*) AS Cnt, SUM(x.TotalCost) AS Total FROM dbo.Prescriptions x WHERE x.VisitID = v.VisitID) pr WHERE v.VisitID &gt; 0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
