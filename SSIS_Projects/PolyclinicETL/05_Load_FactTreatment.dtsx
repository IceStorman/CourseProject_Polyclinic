    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{3EF83E82-D422-4710-B882-BFDCB8B63ABD}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT r.RecordID, r.PatientID, r.AttendingDoctorID AS DoctorID, dg.DiseaseID, r.OpenDate, r.CloseDate, r.Outcome, dg.Severity, ds.AvgTreatmentDays, DATEDIFF(YEAR, p.BirthDate, r.OpenDate) - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.BirthDate, r.OpenDate), p.BirthDate) &gt; r.OpenDate THEN 1 ELSE 0 END AS AgeAtEvent, cm.Comorbidities, cm.Complications, v.Cost, CASE WHEN v.Status = N'Відбувся' THEN 1 ELSE 0 END AS IsCompletedVisit FROM dbo.MedicalRecords r JOIN dbo.Patients p ON p.PatientID = r.PatientID JOIN dbo.Diagnoses dg ON dg.RecordID = r.RecordID AND dg.DiagnosisType = N'Основний' JOIN dbo.Diseases ds ON ds.DiseaseID = dg.DiseaseID JOIN dbo.Visits v ON v.RecordID = r.RecordID CROSS APPLY (SELECT SUM(CASE WHEN x.DiagnosisType = N'Супутній' THEN 1 ELSE 0 END) AS Comorbidities, SUM(CASE WHEN x.DiagnosisType = N'Ускладнення' THEN 1 ELSE 0 END) AS Complications FROM dbo.Diagnoses x WHERE x.RecordID = r.RecordID) cm WHERE r.Status = N'Закрита' AND r.ModifiedAt &gt; '&quot; + @[User::TreatmentWatermark] + &quot;' AND r.ModifiedAt &lt;= '&quot; + @[User::NewTreatmentWatermark] + &quot;'&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlTreatment">
      <DTS:VariableValue
        DTS:DataType="8">SELECT r.RecordID, r.PatientID, r.AttendingDoctorID AS DoctorID, dg.DiseaseID, r.OpenDate, r.CloseDate, r.Outcome, dg.Severity, ds.AvgTreatmentDays, DATEDIFF(YEAR, p.BirthDate, r.OpenDate) - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.BirthDate, r.OpenDate), p.BirthDate) &gt; r.OpenDate THEN 1 ELSE 0 END AS AgeAtEvent, cm.Comorbidities, cm.Complications, v.Cost, CASE WHEN v.Status = N'Відбувся' THEN 1 ELSE 0 END AS IsCompletedVisit FROM dbo.MedicalRecords r JOIN dbo.Patients p ON p.PatientID = r.PatientID JOIN dbo.Diagnoses dg ON dg.RecordID = r.RecordID AND dg.DiagnosisType = N'Основний' JOIN dbo.Diseases ds ON ds.DiseaseID = dg.DiseaseID JOIN dbo.Visits v ON v.RecordID = r.RecordID CROSS APPLY (SELECT SUM(CASE WHEN x.DiagnosisType = N'Супутній' THEN 1 ELSE 0 END) AS Comorbidities, SUM(CASE WHEN x.DiagnosisType = N'Ускладнення' THEN 1 ELSE 0 END) AS Complications FROM dbo.Diagnoses x WHERE x.RecordID = r.RecordID) cm WHERE r.Status = N'Закрита' AND r.ModifiedAt &gt; '1900-01-01 00:00:00' AND r.ModifiedAt &lt;= '1900-01-01 00:00:00'</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
