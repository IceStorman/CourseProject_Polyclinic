    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{253881D0-3301-401C-8701-44A9A96EBA09}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT pr.PrescriptionID, pr.VisitID, CAST(v.VisitDateTime AS date) AS VisitDate, r.PatientID, v.DoctorID, dg.DiseaseID, pr.MedicationID, DATEDIFF(YEAR, p.BirthDate, CAST(v.VisitDateTime AS date)) - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.BirthDate, CAST(v.VisitDateTime AS date)), p.BirthDate) &gt; CAST(v.VisitDateTime AS date) THEN 1 ELSE 0 END AS AgeAtEvent, pr.Quantity, pr.UnitPrice, CAST(pr.TotalCost AS decimal(12,2)) AS TotalCost, pr.DurationDays, pr.TimesPerDay FROM dbo.Prescriptions pr JOIN dbo.Visits v ON v.VisitID = pr.VisitID JOIN dbo.MedicalRecords r ON r.RecordID = v.RecordID JOIN dbo.Patients p ON p.PatientID = r.PatientID JOIN dbo.Diagnoses dg ON dg.RecordID = r.RecordID AND dg.DiagnosisType = N'Основний' WHERE pr.PrescriptionID &gt; &quot; + @[User::LastPrescriptionID]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlPrescriptions">
      <DTS:VariableValue
        DTS:DataType="8">SELECT pr.PrescriptionID, pr.VisitID, CAST(v.VisitDateTime AS date) AS VisitDate, r.PatientID, v.DoctorID, dg.DiseaseID, pr.MedicationID, DATEDIFF(YEAR, p.BirthDate, CAST(v.VisitDateTime AS date)) - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, p.BirthDate, CAST(v.VisitDateTime AS date)), p.BirthDate) &gt; CAST(v.VisitDateTime AS date) THEN 1 ELSE 0 END AS AgeAtEvent, pr.Quantity, pr.UnitPrice, CAST(pr.TotalCost AS decimal(12,2)) AS TotalCost, pr.DurationDays, pr.TimesPerDay FROM dbo.Prescriptions pr JOIN dbo.Visits v ON v.VisitID = pr.VisitID JOIN dbo.MedicalRecords r ON r.RecordID = v.RecordID JOIN dbo.Patients p ON p.PatientID = r.PatientID JOIN dbo.Diagnoses dg ON dg.RecordID = r.RecordID AND dg.DiagnosisType = N'Основний' WHERE pr.PrescriptionID &gt; 0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
