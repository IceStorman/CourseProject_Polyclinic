    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{6ED108D0-6B2B-4AA0-8B57-F10689CC28AA}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT d.DoctorID, d.LastName, d.FirstName, d.MiddleName, d.Gender AS GenderRaw, s.Name AS Specialty, dep.Name AS Department, d.Category, d.HireDate, d.DismissalDate, d.ModifiedAt FROM dbo.Doctors d JOIN dbo.Specialties s ON s.SpecialtyID = d.SpecialtyID JOIN dbo.Departments dep ON dep.DepartmentID = d.DepartmentID WHERE d.ModifiedAt &gt; '&quot; + @[User::DoctorWatermark] + &quot;'&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlDoctors">
      <DTS:VariableValue
        DTS:DataType="8">SELECT d.DoctorID, d.LastName, d.FirstName, d.MiddleName, d.Gender AS GenderRaw, s.Name AS Specialty, dep.Name AS Department, d.Category, d.HireDate, d.DismissalDate, d.ModifiedAt FROM dbo.Doctors d JOIN dbo.Specialties s ON s.SpecialtyID = d.SpecialtyID JOIN dbo.Departments dep ON dep.DepartmentID = d.DepartmentID WHERE d.ModifiedAt &gt; '1900-01-01 00:00:00'</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{DFFCACE6-F11F-41FC-BC7B-7240A98DD89B}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT p.PatientID, p.LastName AS LastNameRaw, p.FirstName AS FirstNameRaw, p.MiddleName AS MiddleNameRaw, p.Gender AS GenderRaw, p.BirthDate, p.BloodType AS BloodTypeRaw, c.Name AS City, r.Name AS Region, p.InsurancePolicy, p.ModifiedAt FROM dbo.Patients p JOIN dbo.Cities c ON c.CityID = p.CityID JOIN dbo.Regions r ON r.RegionID = c.RegionID WHERE p.ModifiedAt &gt; '&quot; + @[User::PatientWatermark] + &quot;'&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlPatients">
      <DTS:VariableValue
        DTS:DataType="8">SELECT p.PatientID, p.LastName AS LastNameRaw, p.FirstName AS FirstNameRaw, p.MiddleName AS MiddleNameRaw, p.Gender AS GenderRaw, p.BirthDate, p.BloodType AS BloodTypeRaw, c.Name AS City, r.Name AS Region, p.InsurancePolicy, p.ModifiedAt FROM dbo.Patients p JOIN dbo.Cities c ON c.CityID = p.CityID JOIN dbo.Regions r ON r.RegionID = c.RegionID WHERE p.ModifiedAt &gt; '1900-01-01 00:00:00'</DTS:VariableValue>
    </DTS:Variable>
